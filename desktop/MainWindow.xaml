<Window x:Class="KitaplikEditoru.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:ui="clr-namespace:KitaplikEditoru"
        Title="{DynamicResource App.Title}" Width="1440" Height="920" MinWidth="1024" MinHeight="680"
        Icon="Assets/epub-atolyesi.ico"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="RibbonToolButton" TargetType="Button">
      <Setter Property="Width" Value="58" />
      <Setter Property="Height" Value="58" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ToolTipService.ShowDuration" Value="8000" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ui:IconGlyph.Glyph)}"
                           FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2" />
                <TextBlock Text="{TemplateBinding Content}" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#1F176B62" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PanelBorder}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#3A176B62" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PaletteToolButton" TargetType="Button" BasedOn="{StaticResource RibbonToolButton}">
      <Setter Property="Width" Value="76" />
      <Setter Property="Height" Value="58" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style x:Key="GlyphMenuItem" TargetType="MenuItem">
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style x:Key="SourceModeToggleButton" TargetType="Button">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=(ui:IconGlyph.Glyph)}"
                         FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" />
              <TextBlock Text="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBackground}">
      <MenuItem Header="{DynamicResource Menu.File}" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8E5;">
        <MenuItem Header="{DynamicResource File.New}" Command="{Binding CreateNewCommand}" InputGestureText="Ctrl+N" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE710;" />
        <Separator />
        <MenuItem x:Name="RecentFilesMenu" Header="{DynamicResource File.Recent}" SubmenuOpened="RecentFilesMenu_SubmenuOpened" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8A5;" />
        <Separator />
        <MenuItem Header="{DynamicResource File.Open}" Command="{Binding OpenEpubCommand}" InputGestureText="Ctrl+O" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8E5;" />
        <MenuItem Header="{DynamicResource File.Save}" Click="Save_Click" InputGestureText="Ctrl+S" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE74E;" />
        <MenuItem Header="{DynamicResource File.SaveAs}" Click="SaveAs_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE792;" />
        <MenuItem Header="{DynamicResource File.Backup}" IsCheckable="True" IsChecked="{Binding BackupEnabled, Mode=TwoWay}" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE9D5;" />
        <Separator />
        <MenuItem Header="{DynamicResource File.Exit}" Click="Exit_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE7E8;" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu.Edit}" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE70F;">
        <MenuItem Header="{DynamicResource Action.Undo}" Click="Undo_Click" InputGestureText="Ctrl+Z" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE7A7;" />
        <MenuItem Header="{DynamicResource Action.Redo}" Click="Redo_Click" InputGestureText="Ctrl+Y" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE7A6;" />
        <Separator />
        <MenuItem Header="{DynamicResource Action.SelectAll}" Click="SelectAll_Click" InputGestureText="Ctrl+A" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8B3;" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu.Format}" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D2;">
        <MenuItem Header="{DynamicResource Format.Bold}" Click="Format_Click" Tag="bold" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8DD;">
          <MenuItem.Icon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DD;" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{DynamicResource Format.Italic}" Click="Format_Click" Tag="italic" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8DB;">
          <MenuItem.Icon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DB;" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{DynamicResource Format.Underline}" Click="Format_Click" Tag="underline" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8DC;">
          <MenuItem.Icon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DC;" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{DynamicResource Format.Strike}" Click="Format_Click" Tag="strikeThrough" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xEDE0;" />
        <Separator />
        <MenuItem Header="{DynamicResource Format.Paragraph}" Click="Block_Click" Tag="p" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8A5;" />
        <MenuItem Header="{DynamicResource Format.Heading1}" Click="Block_Click" Tag="h1" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D2;" />
        <MenuItem Header="{DynamicResource Format.Heading2}" Click="Block_Click" Tag="h2" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D2;" />
        <MenuItem Header="{DynamicResource Format.Heading3}" Click="Block_Click" Tag="h3" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D2;" />
        <MenuItem Header="{DynamicResource Format.Heading4}" Click="Block_Click" Tag="h4" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D2;" />
        <MenuItem Header="{DynamicResource Format.Heading5}" Click="Block_Click" Tag="h5" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D2;" />
        <MenuItem Header="{DynamicResource Format.Heading6}" Click="Block_Click" Tag="h6" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D2;" />
        <MenuItem Header="{DynamicResource Format.Quote}" Click="Block_Click" Tag="blockquote" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D2;" />
        <Separator />
        <MenuItem Header="{DynamicResource Format.Superscript}" Click="Format_Click" Tag="superscript" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D2;" />
        <MenuItem Header="{DynamicResource Format.Subscript}" Click="Format_Click" Tag="subscript" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D2;" />
        <MenuItem Header="{DynamicResource Format.Bullets}" Click="Format_Click" Tag="insertUnorderedList" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8FD;" />
        <MenuItem Header="{DynamicResource Format.Numbering}" Click="Format_Click" Tag="insertOrderedList" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8F0;" />
        <MenuItem Header="{DynamicResource Tools.HorizontalRule}" Click="Format_Click" Tag="insertHorizontalRule" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE9D9;" />
        <Separator />
        <MenuItem Header="{DynamicResource Format.Left}" Click="Format_Click" Tag="justifyLeft" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8E4;" />
        <MenuItem Header="{DynamicResource Format.Center}" Click="Format_Click" Tag="justifyCenter" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8E3;" />
        <MenuItem Header="{DynamicResource Format.Right}" Click="Format_Click" Tag="justifyRight" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8E2;" />
        <MenuItem Header="{DynamicResource Format.Justify}" Click="Format_Click" Tag="justifyFull" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8E1;" />
        <MenuItem Header="{DynamicResource Format.Indent}" Click="Format_Click" Tag="indent" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE7A7;" />
        <MenuItem Header="{DynamicResource Format.Outdent}" Click="Format_Click" Tag="outdent" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE7A6;" />
        <MenuItem Header="{DynamicResource Format.Clear}" Click="Format_Click" Tag="removeFormat" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xEDE1;" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu.Insert}" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE710;">
        <MenuItem Header="{DynamicResource Tools.Table}" Click="Table_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE80A;" />
        <MenuItem Header="{DynamicResource Tools.Bookmark}" Click="Bookmark_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE734;" />
        <MenuItem Header="{DynamicResource Tools.InternalLink}" Click="InternalLink_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE71B;" />
        <MenuItem Header="{DynamicResource Tools.PageBreak}" Click="PageBreak_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8A5;" />
        <MenuItem Header="{DynamicResource Tools.Footnote}" Click="Footnote_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE82F;" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu.Tools}" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE713;">
        <MenuItem Header="{DynamicResource Tools.Find}" Click="Find_Click" InputGestureText="Ctrl+F" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE721;" />
        <MenuItem Header="{DynamicResource Tools.Replace}" Click="Replace_Click" InputGestureText="Ctrl+H" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D4;" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu.Document}" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8A5;">
        <MenuItem Header="{DynamicResource Book.Metadata}" Click="Metadata_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8A5;" />
        <MenuItem Header="{DynamicResource Book.SetCover}" Click="SetCover_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE91B;" />
        <MenuItem Header="{DynamicResource Book.OpenCoverEditor}" Click="OpenCoverEditor_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE91B;" />
        <MenuItem Header="{DynamicResource Book.GenerateToc}" Click="GenerateToc_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8EF;" />
        <MenuItem Header="{DynamicResource Book.OpenTocEditor}" Click="OpenTocEditor_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8EF;" />
        <MenuItem Header="{DynamicResource Book.SplitSection}" Click="SplitSection_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D6;" />
        <MenuItem Header="{DynamicResource Book.MergeSection}" Click="MergeSection_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8D7;" />
        <Separator />
        <MenuItem x:Name="ValidateBookMenuItem" Header="{DynamicResource Book.Validate}" Click="ValidateBook_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE930;" />
        <MenuItem Header="{DynamicResource Book.ImportSection}" Click="ImportSection_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8B5;" />
        <MenuItem Header="{DynamicResource Book.ExportSection}" Click="ExportSection_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8B6;" />
        <Separator />
        <MenuItem Header="{DynamicResource Editor.Source}" Click="SourceMode_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE943;" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu.View}" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE7B3;">
        <MenuItem x:Name="LeftPanelToggle" Header="{DynamicResource View.LeftPanel}" IsCheckable="True" IsChecked="True" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8A5;" />
        <MenuItem x:Name="PalettePanelToggle" Header="{DynamicResource View.RightPanel}" IsCheckable="True" IsChecked="True" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8A5;" />
        <Separator />
        <MenuItem Header="{DynamicResource View.DarkTheme}" IsCheckable="True" IsChecked="{Binding DarkTheme, Mode=TwoWay}" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE708;" />
        <MenuItem Header="{DynamicResource View.ReaderPreview}" Click="ReaderPreview_Click" Style="{StaticResource GlyphMenuItem}" ui:IconGlyph.Glyph="&#xE8A5;" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu.Help}" Click="Help_Click" Style="{StaticResource GlyphMenuItem}" />
    </Menu>

    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="5,2">
      <TabControl MinHeight="82" MaxHeight="92">
        <TabItem Header="{DynamicResource Ribbon.Home}">
          <ToolBarTray IsLocked="True">
            <ToolBar Background="Transparent" BorderThickness="0" Padding="0">
              <Button Style="{StaticResource RibbonToolButton}" Command="{Binding CreateNewCommand}" ui:IconGlyph.Glyph="&#xE710;" Content="{DynamicResource Toolbar.New}" ToolTip="{DynamicResource File.New}" />
              <Button Style="{StaticResource RibbonToolButton}" Command="{Binding OpenEpubCommand}" ui:IconGlyph.Glyph="&#xE8E5;" Content="{DynamicResource Toolbar.Open}" ToolTip="{DynamicResource File.Open}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Save_Click" ui:IconGlyph.Glyph="&#xE74E;" Content="{DynamicResource Toolbar.Save}" ToolTip="{DynamicResource File.Save}" />
              <Separator />
              <Button Style="{StaticResource RibbonToolButton}" Click="Undo_Click" ui:IconGlyph.Glyph="&#xE7A7;" Content="{DynamicResource Action.Undo}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Redo_Click" ui:IconGlyph.Glyph="&#xE7A6;" Content="{DynamicResource Action.Redo}" />
              <Separator />
              <Button Style="{StaticResource RibbonToolButton}" Click="Format_Click" Tag="bold" ui:IconGlyph.Glyph="&#xE8DD;" Content="{DynamicResource Format.Bold}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Format_Click" Tag="italic" ui:IconGlyph.Glyph="&#xE8DB;" Content="{DynamicResource Format.Italic}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Format_Click" Tag="underline" ui:IconGlyph.Glyph="&#xE8DC;" Content="{DynamicResource Format.Underline}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Format_Click" Tag="strikeThrough" ui:IconGlyph.Glyph="&#xEDE0;" Content="{DynamicResource Format.Strike}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Block_Click" Tag="h1" ui:IconGlyph.Glyph="&#xE8D2;" Content="{DynamicResource Format.Heading1}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Block_Click" Tag="blockquote" ui:IconGlyph.Glyph="&#xE8D2;" Content="{DynamicResource Format.Quote}" />
              <Separator />
              <Button Style="{StaticResource RibbonToolButton}" Click="Format_Click" Tag="insertUnorderedList" ui:IconGlyph.Glyph="&#xE8FD;" Content="{DynamicResource Format.Bullets}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Format_Click" Tag="insertOrderedList" ui:IconGlyph.Glyph="&#xE8F0;" Content="{DynamicResource Format.Numbering}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Format_Click" Tag="justifyLeft" ui:IconGlyph.Glyph="&#xE8E4;" Content="{DynamicResource Format.Left}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Format_Click" Tag="justifyCenter" ui:IconGlyph.Glyph="&#xE8E3;" Content="{DynamicResource Format.Center}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Format_Click" Tag="justifyRight" ui:IconGlyph.Glyph="&#xE8E2;" Content="{DynamicResource Format.Right}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Format_Click" Tag="justifyFull" ui:IconGlyph.Glyph="&#xE8E1;" Content="{DynamicResource Format.Justify}" />
              <Separator />
              <Button Style="{StaticResource RibbonToolButton}" Click="PreviousSection_Click" ui:IconGlyph.Glyph="&#xE72B;" Content="{DynamicResource Toolbar.Previous}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="NextSection_Click" ui:IconGlyph.Glyph="&#xE72A;" Content="{DynamicResource Toolbar.Next}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Search_Click" ui:IconGlyph.Glyph="&#xE721;" Content="{DynamicResource Tools.Find}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Replace_Click" ui:IconGlyph.Glyph="&#xE8D4;" Content="{DynamicResource Tools.Replace}" />
              <TextBox x:Name="SearchTextBox" Width="140" Margin="4,8" VerticalContentAlignment="Center" ToolTip="{DynamicResource Toolbar.Search}" KeyDown="SearchTextBox_KeyDown" />
            </ToolBar>
          </ToolBarTray>
        </TabItem>
        <TabItem Header="{DynamicResource Ribbon.Insert}">
          <ToolBarTray IsLocked="True">
            <ToolBar Background="Transparent" BorderThickness="0" Padding="0">
              <Button Style="{StaticResource RibbonToolButton}" Click="Image_Click" ui:IconGlyph.Glyph="&#xE91B;" Content="{DynamicResource Tools.Image}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Link_Click" ui:IconGlyph.Glyph="&#xE71B;" Content="{DynamicResource Tools.Link}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Table_Click" ui:IconGlyph.Glyph="&#xE80A;" Content="{DynamicResource Tools.Table}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Format_Click" Tag="insertHorizontalRule" ui:IconGlyph.Glyph="&#xE9D9;" Content="{DynamicResource Tools.HorizontalRule}" />
              <Separator />
              <Button Style="{StaticResource RibbonToolButton}" Click="Bookmark_Click" ui:IconGlyph.Glyph="&#xE734;" Content="{DynamicResource Tools.Bookmark}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="InternalLink_Click" ui:IconGlyph.Glyph="&#xE71B;" Content="{DynamicResource Tools.InternalLink}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="PageBreak_Click" ui:IconGlyph.Glyph="&#xE8A5;" Content="{DynamicResource Tools.PageBreak}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="Footnote_Click" ui:IconGlyph.Glyph="&#xE82F;" Content="{DynamicResource Tools.Footnote}" />
            </ToolBar>
          </ToolBarTray>
        </TabItem>
        <TabItem Header="{DynamicResource Ribbon.Document}">
          <ToolBarTray IsLocked="True">
            <ToolBar Background="Transparent" BorderThickness="0" Padding="0">
              <Button Style="{StaticResource RibbonToolButton}" Click="Metadata_Click" ui:IconGlyph.Glyph="&#xE8A5;" Content="{DynamicResource Book.Metadata}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="SetCover_Click" ui:IconGlyph.Glyph="&#xE91B;" Content="{DynamicResource Book.SetCover}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="GenerateToc_Click" ui:IconGlyph.Glyph="&#xE8EF;" Content="{DynamicResource Book.GenerateToc}" />
              <Separator />
              <Button Style="{StaticResource RibbonToolButton}" Click="SplitSection_Click" ui:IconGlyph.Glyph="&#xE8D6;" Content="{DynamicResource Book.SplitSection}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="MergeSection_Click" ui:IconGlyph.Glyph="&#xE8D7;" Content="{DynamicResource Book.MergeSection}" />
              <Button x:Name="ValidateBookButton" Style="{StaticResource RibbonToolButton}" Click="ValidateBook_Click" ui:IconGlyph.Glyph="&#xE930;" Content="{DynamicResource Book.Validate}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="ImportSection_Click" ui:IconGlyph.Glyph="&#xE8B5;" Content="{DynamicResource Book.ImportSection}" />
              <Button Style="{StaticResource RibbonToolButton}" Click="ExportSection_Click" ui:IconGlyph.Glyph="&#xE8B6;" Content="{DynamicResource Book.ExportSection}" />
              <Separator />
              <Button Style="{StaticResource RibbonToolButton}" Click="ReaderPreview_Click" ui:IconGlyph.Glyph="&#xE8A5;" Content="{DynamicResource View.ReaderPreview}" />
            </ToolBar>
          </ToolBarTray>
        </TabItem>
      </TabControl>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="10,6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="{Binding TotalWordCountText}" Margin="0,0,10,0" />
            <TextBlock Text="{Binding CurrentWordCountText}" />
          </StackPanel>
          <TextBlock Text="{Binding CurrentFilePath}" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
      </DockPanel>
    </Border>

    <Grid Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftPanelColumn" Width="250" MinWidth="190" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="400" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition x:Name="RightPanelColumn" Width="280" MinWidth="220" />
      </Grid.ColumnDefinitions>
      <GridSplitter x:Name="LeftPanelSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource PanelBorder}" />
      <GridSplitter x:Name="RightPanelSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource PanelBorder}" />

      <Grid x:Name="LeftPanel" Grid.Column="0" Margin="0,0,5,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" MinHeight="230" />
          <RowDefinition Height="5" />
          <RowDefinition Height="2*" MinHeight="160" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Panel.Organizer}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="12,10" />
            <TabControl x:Name="OrganizerTabs">
              <TabItem x:Name="ProjectTab" Header="{DynamicResource Tab.Projects}">
                <DockPanel Margin="8">
                  <TextBlock DockPanel.Dock="Top" Text="{Binding BookTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="3,4,3,8" />
                  <TreeView x:Name="SectionsTree" SelectedItemChanged="Section_TreeSelectionChanged" PreviewMouseLeftButtonDown="SectionsTree_MouseDown" PreviewMouseMove="SectionsTree_PreviewMouseMove" DragOver="SectionsTree_DragOver" Drop="SectionsTree_Drop" AllowDrop="True" BorderThickness="0">
                    <TreeView.Resources>
                      <Style TargetType="TreeViewItem">
                        <Setter Property="ContextMenu">
                          <Setter.Value>
                            <ContextMenu>
                              <ContextMenu.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                              </ContextMenu.ItemsPanel>
                            </ContextMenu>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </TreeView.Resources>
                    <TreeViewItem Header="{DynamicResource Panel.Content}" IsExpanded="True" ItemsSource="{Binding Sections}">
                      <TreeViewItem.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="3,4"><TextBlock Text="▤" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></TreeViewItem.ItemTemplate>
                    </TreeViewItem>
                    <TreeViewItem Header="{DynamicResource Tree.Cover}" ItemsSource="{Binding CoverResources}"><TreeViewItem.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Margin="3,4" /></DataTemplate></TreeViewItem.ItemTemplate></TreeViewItem>
                    <TreeViewItem Header="{DynamicResource Tree.Images}" ItemsSource="{Binding ImageResources}"><TreeViewItem.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Margin="3,4" /></DataTemplate></TreeViewItem.ItemTemplate></TreeViewItem>
                    <TreeViewItem Header="{DynamicResource Tree.Styles}" ItemsSource="{Binding StyleResources}"><TreeViewItem.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Margin="3,4" /></DataTemplate></TreeViewItem.ItemTemplate></TreeViewItem>
                    <TreeViewItem Header="{DynamicResource Tree.OtherFiles}" ItemsSource="{Binding OtherResources}"><TreeViewItem.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Margin="3,4" /></DataTemplate></TreeViewItem.ItemTemplate></TreeViewItem>
                  </TreeView>
                </DockPanel>
              </TabItem>
              <TabItem x:Name="CoverTab" Header="{DynamicResource Tab.Cover}">
                <DockPanel Margin="10">
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{DynamicResource Cover.PickImage}" Foreground="{StaticResource TextSecondary}" Margin="2,2,2,6" />
                    <ComboBox x:Name="CoverImagePicker" ItemsSource="{Binding CoverImageChoices}"
                              SelectedItem="{Binding CurrentCoverResource, Mode=OneWay}"
                              DisplayMemberPath="DisplayName" SelectionChanged="CoverImagePicker_SelectionChanged"
                              Margin="0,0,0,8" />
                    <WrapPanel HorizontalAlignment="Center">
                      <Button Style="{StaticResource PaletteToolButton}" Click="SetSelectedCover_Click" ui:IconGlyph.Glyph="&#xE91B;" Content="{DynamicResource Cover.UseSelected}" />
                      <Button Style="{StaticResource PaletteToolButton}" Click="SetCover_Click" ui:IconGlyph.Glyph="&#xE710;" Content="{DynamicResource Cover.Replace}" />
                    </WrapPanel>
                  </StackPanel>
                  <Border Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource PanelBorder}"
                          BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                    <Grid>
                      <TextBlock x:Name="CoverPreviewPlaceholder" Text="{DynamicResource Cover.NoSelection}"
                                 Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                      <Image x:Name="CoverPreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                      <wv2:WebView2 x:Name="CoverPreviewWebView" Visibility="Collapsed" />
                    </Grid>
                  </Border>
                </DockPanel>
              </TabItem>
              <TabItem x:Name="TocTab" Header="{DynamicResource Tab.Toc}">
                <DockPanel Margin="6">
                  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{DynamicResource Book.GenerateToc}" Click="GenerateToc_Click" />
                    <Button Content="↑" Click="TocMoveUp_Click" ToolTip="{DynamicResource Toc.MoveUp}" />
                    <Button Content="↓" Click="TocMoveDown_Click" ToolTip="{DynamicResource Toc.MoveDown}" />
                    <Button Content="←" Click="TocOutdent_Click" ToolTip="{DynamicResource Toc.Outdent}" />
                    <Button Content="→" Click="TocIndent_Click" ToolTip="{DynamicResource Toc.Indent}" />
                    <Button Content="{DynamicResource Toc.Rename}" Click="TocRename_Click" />
                  </StackPanel>
                  <ListBox x:Name="TocList" ItemsSource="{Binding TableOfContents}" SelectionChanged="TocList_SelectionChanged" BorderThickness="0">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Level, Converter={StaticResource TocIndentConverter}}" /><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </TabItem>
              <TabItem Header="{DynamicResource Tab.Favorites}"><TextBlock Text="{DynamicResource Tab.Favorites}" Margin="12" Foreground="{StaticResource TextSecondary}" /></TabItem>
              <TabItem Header="{DynamicResource Tab.Explorer}"><ListBox ItemsSource="{Binding Resources}" DisplayMemberPath="DisplayName" BorderThickness="0" /></TabItem>
            </TabControl>
          </DockPanel>
        </Border>
        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource PanelBorder}" />
        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Panel.Control}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="12,10" />
            <TabControl>
              <TabItem Header="{DynamicResource Tab.Build}"><StackPanel Margin="10"><TextBlock Text="EPUB" FontWeight="SemiBold" Margin="3"/><Button x:Name="ValidateControlButton" Content="{DynamicResource Control.Check}" Click="ValidateBook_Click" IsEnabled="False"/><Button Content="{DynamicResource Control.Launch}" IsEnabled="False"/></StackPanel></TabItem>
              <TabItem Header="{DynamicResource Tab.Files}"><ListBox ItemsSource="{Binding Resources}" DisplayMemberPath="DisplayName" BorderThickness="0" /></TabItem>
              <TabItem Header="{DynamicResource Tab.Results}">
                <ListBox ItemsSource="{Binding SearchResults}" SelectionChanged="SearchResults_SelectionChanged" BorderThickness="0">
                  <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding SectionTitle}" FontWeight="SemiBold"/><TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </TabItem>
            </TabControl>
          </DockPanel>
        </Border>
      </Grid>

      <Grid Grid.Column="2" Margin="5,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition x:Name="IssuePanelRow" Height="0" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Height="34">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="112" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="‹" Padding="0" Click="ScrollSectionTabsLeft_Click"
                  ToolTip="{DynamicResource Editor.PreviousTab}" />
          <ScrollViewer x:Name="SectionTabsScrollViewer" Grid.Column="1"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                        CanContentScroll="False">
            <ListBox x:Name="SectionTabsList" ItemsSource="{Binding OpenSections}"
                     SelectedItem="{Binding CurrentSection, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Height" Value="30" />
                  <Setter Property="MinWidth" Value="90" />
                  <Setter Property="MaxWidth" Value="190" />
                  <Setter Property="Padding" Value="4,0" />
                  <Setter Property="Margin" Value="1,1" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="VerticalContentAlignment" Value="Center" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                      <Setter Property="Foreground" Value="White" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="×" Padding="4,0" Margin="4,0,0,0"
                            Tag="{Binding}" Click="CloseSectionTab_Click"
                            ToolTip="{DynamicResource Editor.CloseTab}" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
          <Button Grid.Column="2" Content="›" Padding="0" Click="ScrollSectionTabsRight_Click"
                  ToolTip="{DynamicResource Editor.NextTab}" />
          <Button x:Name="SourceModeButton" Grid.Column="3" Style="{StaticResource SourceModeToggleButton}"
                  Content="{DynamicResource Editor.Source}" Click="SourceMode_Click"
                  ui:IconGlyph.Glyph="&#xE943;" IsEnabled="False" />
        </Grid>
        <Border Grid.Row="1" Background="#E8EBEF" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
          <Grid>
            <wv2:WebView2 x:Name="EditorWebView" Visibility="Collapsed" />
            <avalonedit:TextEditor x:Name="SourceEditor" Visibility="Collapsed" ShowLineNumbers="True"
                                   FontFamily="Consolas" FontSize="13" Padding="12"
                                   TextChanged="SourceEditor_TextChanged">
              <avalonedit:TextEditor.ContextMenu>
                <ContextMenu Opened="SourceEditorContextMenu_Opened">
                  <MenuItem Header="{DynamicResource Action.Undo}" Tag="undo" Click="EditorTextContextMenu_Click" />
                  <MenuItem Header="{DynamicResource Action.Redo}" Tag="redo" Click="EditorTextContextMenu_Click" />
                  <Separator />
                  <MenuItem Header="{DynamicResource Tools.Cut}" Tag="cut" Click="EditorTextContextMenu_Click" />
                  <MenuItem Header="{DynamicResource Tools.Copy}" Tag="copy" Click="EditorTextContextMenu_Click" />
                  <MenuItem Header="{DynamicResource Tools.Paste}" Tag="paste" Click="EditorTextContextMenu_Click" />
                  <MenuItem Header="{DynamicResource Action.SelectAll}" Tag="selectAll" Click="EditorTextContextMenu_Click" />
                  <Separator />
                  <MenuItem Header="{DynamicResource Tools.Find}" Tag="find" Click="EditorTextContextMenu_Click" />
                  <MenuItem Header="{DynamicResource Tools.Replace}" Tag="replace" Click="EditorTextContextMenu_Click" />
                </ContextMenu>
              </avalonedit:TextEditor.ContextMenu>
            </avalonedit:TextEditor>
            <StackPanel x:Name="NoBookPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Visibility="Visible">
              <TextBlock Text="{DynamicResource Editor.OpenTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="12" />
              <TextBlock Text="{DynamicResource Editor.DropHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="12" />
              <Button Content="{DynamicResource File.Open}" Command="{Binding OpenEpubCommand}" HorizontalAlignment="Center" Padding="22,10" />
            </StackPanel>
            <StackPanel x:Name="WebViewWarning" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Visibility="Collapsed" Margin="24">
              <TextBlock Text="{DynamicResource Editor.WebViewTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="8" />
              <TextBlock Text="{DynamicResource Editor.WebViewHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="8" />
              <TextBlock HorizontalAlignment="Center" Margin="8"><Hyperlink NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/" RequestNavigate="WebViewLink_RequestNavigate"><Run Text="{DynamicResource Editor.WebViewDownload}" /></Hyperlink></TextBlock>
            </StackPanel>
          </Grid>
        </Border>
        <Border x:Name="IssuesPanel" Grid.Row="2" Visibility="Collapsed"
                Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" Margin="0,6,0,0" Padding="6">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
              <Button DockPanel.Dock="Right" Content="×" Click="CloseIssuesPanel_Click"
                      ToolTip="{DynamicResource Issues.Close}" Padding="8,2" />
              <Button x:Name="FixAllIssuesButton" DockPanel.Dock="Right" Content="{DynamicResource Issues.FixAll}"
                      Click="FixAllIssues_Click" IsEnabled="False" Margin="4,0" />
              <Button x:Name="FixIssueButton" DockPanel.Dock="Right" Content="{DynamicResource Issues.Fix}"
                      Click="FixIssue_Click" IsEnabled="False" Margin="4,0" />
              <Button x:Name="CancelValidationButton" DockPanel.Dock="Right" Content="{DynamicResource Issues.Cancel}"
                      Click="CancelValidation_Click" Visibility="Collapsed" Margin="4,0" />
              <ProgressBar x:Name="ValidationProgress" DockPanel.Dock="Right" Width="100" Height="16"
                           IsIndeterminate="True" Visibility="Collapsed" Margin="8,3" />
              <TextBlock x:Name="ValidationStatusText" DockPanel.Dock="Right" Width="220"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         Visibility="Collapsed" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              <ComboBox x:Name="IssueFilter" DockPanel.Dock="Left" Width="125" SelectedIndex="0"
                        SelectionChanged="IssueFilter_SelectionChanged" Margin="0,0,8,0">
                <ComboBoxItem Content="{DynamicResource Issues.FilterAll}" Tag="All" />
                <ComboBoxItem Content="{DynamicResource Validation.Error}" Tag="Error" />
                <ComboBoxItem Content="{DynamicResource Validation.Warning}" Tag="Warning" />
                <ComboBoxItem Content="{DynamicResource Validation.Information}" Tag="Information" />
              </ComboBox>
              <TextBlock Text="{DynamicResource Issues.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <DataGrid x:Name="IssuesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                      SelectionChanged="IssuesGrid_SelectionChanged" MouseDoubleClick="IssuesGrid_MouseDoubleClick"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Issues.Severity}" Binding="{Binding LevelText}" Width="90" />
                <DataGridTextColumn Header="{DynamicResource Issues.Rule}" Binding="{Binding RuleId}" Width="150" />
                <DataGridTextColumn Header="{DynamicResource Issues.File}" Binding="{Binding File}" Width="2*" />
                <DataGridTextColumn Header="{DynamicResource Issues.Line}" Binding="{Binding Line}" Width="55" />
                <DataGridTextColumn Header="{DynamicResource Issues.Column}" Binding="{Binding Column}" Width="65" />
                <DataGridTextColumn Header="{DynamicResource Issues.Message}" Binding="{Binding Message}" Width="3*" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
        <DockPanel Grid.Row="3" Margin="2,7">
          <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentWordCountText}" Foreground="{StaticResource TextSecondary}" />
          <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Editor.Dirty}" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{StaticResource AccentBrush}" />
          <CheckBox x:Name="InvisibleCharactersCheckBox" Content="{DynamicResource Editor.InvisibleCharacters}"
                    Checked="InvisibleCharacters_Changed" Unchecked="InvisibleCharacters_Changed"
                    HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
        </DockPanel>
      </Grid>

      <Border x:Name="PalettePanel" Grid.Column="4" Margin="5,0,0,0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Panel.Palette}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="12,10" />
          <TabControl>
            <TabItem Header="{DynamicResource Tab.Tools}">
              <TabItem.Resources>
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PaletteToolButton}" />
              </TabItem.Resources>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                <TextBlock Text="{DynamicResource Tools.Formatting}" FontWeight="SemiBold" Margin="4,8" />
                <UniformGrid Columns="3">
                  <Button Click="Format_Click" Tag="bold" ui:IconGlyph.Glyph="&#xE8DD;" Content="{DynamicResource Format.Bold}" ToolTip="{DynamicResource Format.Bold}" />
                  <Button Click="Format_Click" Tag="italic" ui:IconGlyph.Glyph="&#xE8DB;" Content="{DynamicResource Format.Italic}" ToolTip="{DynamicResource Format.Italic}" />
                  <Button Click="Format_Click" Tag="underline" ui:IconGlyph.Glyph="&#xE8DC;" Content="{DynamicResource Format.Underline}" ToolTip="{DynamicResource Format.Underline}" />
                  <Button Click="Block_Click" Tag="p" ui:IconGlyph.Glyph="&#xE8A5;" Content="{DynamicResource Format.Paragraph}" />
                  <Button Click="Block_Click" Tag="h1" ui:IconGlyph.Glyph="&#xE8D2;" Content="{DynamicResource Format.Heading1}" />
                  <Button Click="Block_Click" Tag="h2" ui:IconGlyph.Glyph="&#xE8D2;" Content="{DynamicResource Format.Heading2}" />
                  <Button Click="Block_Click" Tag="h3" ui:IconGlyph.Glyph="&#xE8D2;" Content="{DynamicResource Format.Heading3}" />
                  <Button Click="Block_Click" Tag="h4" ui:IconGlyph.Glyph="&#xE8D2;" Content="{DynamicResource Format.Heading4}" />
                  <Button Click="Block_Click" Tag="h5" ui:IconGlyph.Glyph="&#xE8D2;" Content="{DynamicResource Format.Heading5}" />
                  <Button Click="Block_Click" Tag="h6" ui:IconGlyph.Glyph="&#xE8D2;" Content="{DynamicResource Format.Heading6}" />
                  <Button Click="Block_Click" Tag="blockquote" ui:IconGlyph.Glyph="&#xE8D2;" Content="{DynamicResource Format.Quote}" />
                  <Button Click="Format_Click" Tag="insertUnorderedList" ui:IconGlyph.Glyph="&#xE8FD;" Content="{DynamicResource Format.Bullets}" />
                  <Button Click="Format_Click" Tag="insertOrderedList" ui:IconGlyph.Glyph="&#xE8F0;" Content="{DynamicResource Format.Numbering}" />
                  <Button Click="Format_Click" Tag="removeFormat" ui:IconGlyph.Glyph="&#xEDE1;" Content="{DynamicResource Format.Clear}" />
                  <Button Click="Format_Click" Tag="strikeThrough" ui:IconGlyph.Glyph="&#xEDE0;" Content="{DynamicResource Format.Strike}" />
                  <Button Click="Format_Click" Tag="superscript" ui:IconGlyph.Glyph="&#xE8D2;" Content="{DynamicResource Format.Superscript}" />
                  <Button Click="Format_Click" Tag="subscript" ui:IconGlyph.Glyph="&#xE8D2;" Content="{DynamicResource Format.Subscript}" />
                </UniformGrid>
                <TextBlock Text="{DynamicResource Tools.Alignment}" FontWeight="SemiBold" Margin="4,12,4,5" />
                <UniformGrid Columns="4"><Button Click="Format_Click" Tag="justifyLeft" ui:IconGlyph.Glyph="&#xE8E4;" Content="{DynamicResource Format.Left}"/><Button Click="Format_Click" Tag="justifyCenter" ui:IconGlyph.Glyph="&#xE8E3;" Content="{DynamicResource Format.Center}"/><Button Click="Format_Click" Tag="justifyRight" ui:IconGlyph.Glyph="&#xE8E2;" Content="{DynamicResource Format.Right}"/><Button Click="Format_Click" Tag="justifyFull" ui:IconGlyph.Glyph="&#xE8E1;" Content="{DynamicResource Format.Justify}"/></UniformGrid>
                <UniformGrid Columns="2"><Button Click="Format_Click" Tag="indent" ui:IconGlyph.Glyph="&#xE7A7;" Content="{DynamicResource Format.Indent}"/><Button Click="Format_Click" Tag="outdent" ui:IconGlyph.Glyph="&#xE7A6;" Content="{DynamicResource Format.Outdent}"/></UniformGrid>
                <TextBlock Text="{DynamicResource Tools.Editing}" FontWeight="SemiBold" Margin="4,12,4,5" />
                <UniformGrid Columns="2"><Button Click="Undo_Click" ui:IconGlyph.Glyph="&#xE7A7;" Content="{DynamicResource Action.Undo}"/><Button Click="Redo_Click" ui:IconGlyph.Glyph="&#xE7A6;" Content="{DynamicResource Action.Redo}"/><Button Click="Format_Click" Tag="cut" ui:IconGlyph.Glyph="&#xE8C6;" Content="{DynamicResource Tools.Cut}"/><Button Click="Format_Click" Tag="copy" ui:IconGlyph.Glyph="&#xE8C8;" Content="{DynamicResource Tools.Copy}"/><Button Click="Paste_Click" ui:IconGlyph.Glyph="&#xE77F;" Content="{DynamicResource Tools.Paste}"/><Button Click="Find_Click" ui:IconGlyph.Glyph="&#xE721;" Content="{DynamicResource Tools.Find}"/><Button Click="Replace_Click" ui:IconGlyph.Glyph="&#xE8D4;" Content="{DynamicResource Tools.Replace}"/></UniformGrid>
                <TextBlock Text="{DynamicResource Tools.Objects}" FontWeight="SemiBold" Margin="4,12,4,5" />
                <UniformGrid Columns="2"><Button Click="Image_Click" ui:IconGlyph.Glyph="&#xE91B;" Content="{DynamicResource Tools.Image}"/><Button Click="Link_Click" ui:IconGlyph.Glyph="&#xE71B;" Content="{DynamicResource Tools.Link}"/><Button Click="Format_Click" Tag="insertHorizontalRule" ui:IconGlyph.Glyph="&#xE9D9;" Content="{DynamicResource Tools.HorizontalRule}"/><Button Click="Table_Click" ui:IconGlyph.Glyph="&#xE80A;" Content="{DynamicResource Tools.Table}"/></UniformGrid>
                <TextBlock Text="{DynamicResource Tools.Colors}" FontWeight="SemiBold" Margin="4,12,4,5" />
                <UniformGrid Columns="2"><ComboBox x:Name="TextColorPicker" SelectionChanged="TextColor_SelectionChanged"><ComboBoxItem Content="{DynamicResource Tools.TextColor}" IsSelected="True"/><ComboBoxItem Content="{DynamicResource Tools.Black}" Tag="#202020"/><ComboBoxItem Content="{DynamicResource Tools.Red}" Tag="#B42318"/><ComboBoxItem Content="{DynamicResource Tools.Blue}" Tag="#176B9B"/><ComboBoxItem Content="{DynamicResource Tools.Green}" Tag="#176B62"/></ComboBox><ComboBox x:Name="HighlightColorPicker" SelectionChanged="HighlightColor_SelectionChanged"><ComboBoxItem Content="{DynamicResource Tools.HighlightColor}" IsSelected="True"/><ComboBoxItem Content="{DynamicResource Tools.Yellow}" Tag="#FFF2A8"/><ComboBoxItem Content="{DynamicResource Tools.Green}" Tag="#C9EAD7"/><ComboBoxItem Content="{DynamicResource Tools.Blue}" Tag="#CDE8F6"/></ComboBox></UniformGrid>
                <TextBlock Text="{DynamicResource Tools.Font}" FontWeight="SemiBold" Margin="4,12,4,5" />
                <ComboBox x:Name="FontFamilyPicker" SelectionChanged="FontFamily_SelectionChanged" SelectedIndex="0"><ComboBoxItem Content="Georgia"/><ComboBoxItem Content="Times New Roman"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Verdana"/></ComboBox>
                <ComboBox x:Name="FontSizePicker" SelectionChanged="FontSize_SelectionChanged" SelectedIndex="2" Margin="2,6"><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="18"/><ComboBoxItem Content="24"/></ComboBox>
                <TextBlock Text="{DynamicResource Tools.ParagraphType}" FontWeight="SemiBold" Margin="4,12,4,5" />
                <ComboBox x:Name="ParagraphTypePicker" SelectionChanged="ParagraphStyle_SelectionChanged" SelectedIndex="0" Margin="2,6"><ComboBoxItem Content="{DynamicResource Format.Normal}" Tag="p"/><ComboBoxItem Content="{DynamicResource Format.Heading1}" Tag="h1"/><ComboBoxItem Content="{DynamicResource Format.Heading2}" Tag="h2"/><ComboBoxItem Content="{DynamicResource Format.Heading3}" Tag="h3"/><ComboBoxItem Content="{DynamicResource Format.Heading4}" Tag="h4"/><ComboBoxItem Content="{DynamicResource Format.Heading5}" Tag="h5"/><ComboBoxItem Content="{DynamicResource Format.Heading6}" Tag="h6"/><ComboBoxItem Content="{DynamicResource Format.Quote}" Tag="blockquote"/></ComboBox>
                <TextBlock Text="{DynamicResource Tab.Styles}" FontWeight="SemiBold" Margin="4,12,4,5" />
                <ComboBox x:Name="StylePicker" ItemsSource="{Binding Styles}" DisplayMemberPath="Name" SelectionChanged="Style_SelectionChanged" Margin="2,6" />
              </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource Tab.Styles}">
              <TabItem.Resources>
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PaletteToolButton}" />
              </TabItem.Resources>
              <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Content="{DynamicResource Styles.New}" Click="StyleNew_Click" ui:IconGlyph.Glyph="&#xE710;" />
                  <Button Content="{DynamicResource Styles.Edit}" Click="StyleEdit_Click" ui:IconGlyph.Glyph="&#xE70F;" />
                  <Button Content="{DynamicResource Styles.Delete}" Click="StyleDelete_Click" ui:IconGlyph.Glyph="&#xE74D;" />
                  <Button Content="{DynamicResource Styles.Apply}" Click="StyleApply_Click" ui:IconGlyph.Glyph="&#xE8FB;" />
                </StackPanel>
                <ListBox x:Name="StylesList" ItemsSource="{Binding Styles}" DisplayMemberPath="Name" BorderThickness="0" />
              </DockPanel>
            </TabItem>
            <TabItem Header="{DynamicResource Tab.Objects}" IsEnabled="False"><TextBlock Text="Nesne paleti" Margin="10" /></TabItem>
            <TabItem Header="{DynamicResource Tab.Inspector}">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
                <TextBlock Text="{DynamicResource Inspector.Tag}" />
                <TextBox x:Name="InspectorTag" Margin="0,3,0,8" />
                <TextBlock Text="class" />
                <TextBox x:Name="InspectorClass" Margin="0,3,0,8" />
                <TextBlock Text="id" />
                <TextBox x:Name="InspectorId" Margin="0,3,0,8" />
                <TextBlock Text="style" />
                <TextBox x:Name="InspectorStyle" Margin="0,3,0,8" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                <Button Style="{StaticResource PaletteToolButton}" Content="{DynamicResource Inspector.Apply}" Click="InspectorApply_Click" ui:IconGlyph.Glyph="&#xE8FB;" />
              </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource Tab.Favorites}" IsEnabled="False"><TextBlock Text="{DynamicResource Tab.Favorites}" Margin="10" /></TabItem>
          </TabControl>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>